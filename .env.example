# Copy to .env to override the defaults used by docker-compose.yml

# Port of the web UI on the host (http://localhost:4200)
FRONTEND_PORT=4200

# PostgreSQL credentials (used by the postgres and backend containers)
POSTGRES_DB=traceflow
POSTGRES_USER=traceflow
POSTGRES_PASSWORD=change-me

# Upload limits
TRACEFLOW_MAX_FILE_SIZE=50MB
TRACEFLOW_MAX_REQUEST_SIZE=510MB
TRACEFLOW_MAX_FILES=10

# true disables persistent imports (recommended for public deployments without authentication)
TRACEFLOW_PUBLIC_MODE=false

# Retention policy: analyses older than N days are deleted every night
TRACEFLOW_RETENTION_ENABLED=true
TRACEFLOW_RETENTION_DAYS=30

# Execute every demo scenario once on the first start
TRACEFLOW_DEMO_SEED=true

# Zone used for log timestamps without offset (e.g. 2026-10-27 10:15:30)
TRACEFLOW_DEFAULT_ZONE=UTC

# Allowed CORS origins (only needed when the UI is not served through the bundled Nginx proxy)
TRACEFLOW_CORS_ORIGINS=http://localhost:4200

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
